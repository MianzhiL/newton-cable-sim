{
  "seed": 42,
  "num_steps_per_env": 512,
  "save_interval": 10,
  "obs_groups": {
    "actor": [
      "policy"
    ],
    "critic": [
      "critic"
    ]
  },
  "logger": "tensorboard",
  "actor": {
    "hidden_dims": [
      256,
      256
    ],
    "activation": "elu",
    "obs_normalization": false,
    "distribution_cfg": {
      "init_std": 0.1,
      "std_type": "log",
      "std_range": [
        0.03,
        0.2
      ],
      "class_name": "GaussianDistribution"
    },
    "class_name": "MLPModel"
  },
  "critic": {
    "hidden_dims": [
      256,
      256
    ],
    "activation": "elu",
    "obs_normalization": false,
    "class_name": "MLPModel"
  },
  "algorithm": {
    "num_learning_epochs": 5,
    "num_mini_batches": 4,
    "clip_param": 0.2,
    "gamma": 1.0,
    "lam": 1.0,
    "value_loss_coef": 1.0,
    "entropy_coef": 0.001,
    "learning_rate": 0.0001,
    "max_grad_norm": 1.0,
    "use_clipped_value_loss": false,
    "schedule": "adaptive",
    "desired_kl": 0.01,
    "rnd_cfg": null,
    "symmetry_cfg": null,
    "critic_learning_rate": 0.0003,
    "actor_lr_limit": 0.0001,
    "class_name": "cable_robot_sample.learning.ppo:IndependentCriticPPO"
  },
  "torch_compile_mode": null
}
